<% if @post.image.attached? %>
  <%= image_tag @post.image.variant(resize_to_limit: [600, 600]) %>
<% end %>
<br>
<%= @post.description %>
<div class="link">
  <%= link_to "Destroy", @post, method: :delete, data: { confirm: "Are you sure?" } %>
  <%= link_to "Edit", edit_post_path(@post) %>
</div>

