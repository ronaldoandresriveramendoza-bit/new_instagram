<% @posts.each do |x| %>
  <div>
    <% if x.image.attached? %>
      <%= image_tag x.image.variant(resize_to_limit: [300, 300]) %>
    <% end %>
    <br>
    <%= x.description %>
    <div class="link">
      <%= link_to "Destroy", x, method: :delete, data: { confirm: "Are you sure?" } %>
      <%= link_to "Edit", edit_post_path(x) %>
      <%= link_to "Show", x %>
    </div>
  </div>
<% end %>
